# Azure Distributed Queue System – Environment Variables
# Copy this file to .env and fill in your Azure credentials.

# ─── Azure Service Bus (Broker) ──────────────────────────────────────────
# Get this from: Azure Portal > Service Bus Namespace > Shared access policies > RootManageSharedAccessKey
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>

# Name of the Service Bus queue (will be created if it doesn't exist in your namespace)
AZURE_SERVICEBUS_QUEUE_NAME=broker-queue

# ─── Azure Blob Storage (Persistent Storage) ─────────────────────────────
# Get this from: Azure Portal > Storage Account > Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net

# Name of the blob container for message logs
AZURE_STORAGE_CONTAINER_NAME=broker-logs

# ─── Broker Server ───────────────────────────────────────────────────────
# Address for the HTTP broker to listen on (default: :8080)
BROKER_ADDR=:8080
